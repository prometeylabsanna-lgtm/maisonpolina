SECRET_KEY=change-me-generate-with-secrets
DEBUG=False
ADMIN_URL=change-me-random-path
DJANGO_SETTINGS_MODULE=config.settings.docker

POSTGRES_DB=selfbrand
POSTGRES_USER=selfbrand
POSTGRES_PASSWORD=strong-password
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgres://selfbrand:strong-password@db:5432/selfbrand
DB_SSLMODE=disable

# Replace YOUR_DROPLET_IP with the Droplet IPv4 before first deploy.
# First boot (HTTP): USE_HTTPS=false. After certbot: USE_HTTPS=true + https CSRF.
ALLOWED_HOSTS=maisonpolina.com.ua,www.maisonpolina.com.ua,YOUR_DROPLET_IP,127.0.0.1,localhost,web
CSRF_TRUSTED_ORIGINS=http://maisonpolina.com.ua,http://www.maisonpolina.com.ua,http://YOUR_DROPLET_IP
SECURE_SSL_REDIRECT=False

SITE_URL=http://maisonpolina.com.ua
USE_HTTPS=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://maisonpolina.com.ua/api/telegram/webhook/
DEFAULT_FROM_EMAIL=noreply@maisonpolina.com.ua
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
